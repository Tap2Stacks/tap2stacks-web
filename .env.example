# All VITE_* values are PUBLIC and embedded at build time. Never put secrets here.
# Public canonical web origin (used for OG/Twitter preview tags at build time).
VITE_PUBLIC_URL=https://45-77-250-147.sslip.io
# Backend origin only, without /api. Required when hosted separately on Vercel.
VITE_BACKEND_URL=https://YOUR-BACKEND.fly.dev
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
# Fill from tap2stacks-contracts/deployments/base-sepolia.json (not yet checked in).
VITE_TUSDC_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_PROOF_ANCHOR_ADDRESS=
# Optional public Coinbase CDP project ID; configure allowed origins in CDP too.
VITE_CDP_PROJECT_ID=
# Base Builder Code (public; appended to every app transaction for attribution).
VITE_BASE_BUILDER_CODE=bc_ymo2v08a
VITE_ENABLE_DEV_TOOLS=false
VITE_PREVIEW_TOPUP=false
# Local Vite dev server only. Not used by the Vercel production build.
DEV_BACKEND_PROXY=http://127.0.0.1:5001
